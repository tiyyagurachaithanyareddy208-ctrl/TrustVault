# TrustVault Environment Configuration

# Database Connection (SQLite for zero-dependency local dev/tests; PostgreSQL for production/docker)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:trustvault_secure_pass@localhost:5432/trustvault?schema=public"

# Session & Token Cryptographic Secret (Minimum 32 bytes/64 hex characters)
SESSION_SECRET="e9b2512f71f11a49c6934c2ee347644f126f554030614e861d81a95449557ea7"

# Environment
NODE_ENV="development"
PORT=3000

# Private Document Storage Configuration
STORAGE_DRIVER="local" # "local" or "s3"
LOCAL_STORAGE_DIR="./storage/vault_files"

# Upload Limits & Validation
MAX_FILE_SIZE_BYTES=26214400 # 25 MB
ALLOWED_MIME_TYPES="application/pdf,image/png,image/jpeg,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
ALLOWED_EXTENSIONS=".pdf,.png,.jpg,.jpeg,.docx,.xlsx"

# S3 Configuration (Production Object Storage)
# S3_BUCKET_NAME="trustvault-private-documents"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""
